{
  "manifest_version": 3,
  "name": "İş Akışı Kaydı (WawiERP)",
  "short_name": "İş Akışı",
  "version": "0.1.1",
  "description": "Ofisteki tekrar eden tarayıcı işlerini bulmak için iş akışı kaydı. Yalnız iş sitelerinde, onayla. Şifre, yazılan metin, form değeri, ekran görüntüsü ve kopyalanan içerik toplanmaz.",
  "incognito": "not_allowed",
  "permissions": [
    "storage",
    "tabs",
    "downloads",
    "alarms",
    "idle"
  ],
  "host_permissions": [
    "http://localhost:8787/*",
    "http://127.0.0.1:8787/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "common.js",
        "content.js"
      ],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "İş Akışı Kaydı",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png"
    }
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "storage": {
    "managed_schema": "managed_schema.json"
  }
}