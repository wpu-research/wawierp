{
  "expo": {
    "name": "WMail",
    "slug": "mail-mobil",
    "version": "0.1.0",
    "scheme": "sirketmail",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.seideltrading.wmail",
      "supportsTablet": true
    },
    "android": {
      "package": "com.seideltrading.wmail"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-notifications",
      "expo-asset",
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
